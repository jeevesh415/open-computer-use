{
  "name": "coasty-desktop",
  "version": "3.4.0",
  "description": "Coasty Desktop - AI agent for your local machine",
  "author": "Coasty <support@coasty.ai>",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:win:signed": "powershell -ExecutionPolicy Bypass -File ./sign-and-build.ps1",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:linux": "electron-vite build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "puppeteer-core": "^24.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.3.1",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.8.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0",
    "zustand": "^5.0.3"
  }
}
